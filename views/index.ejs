<!DOCTYPE html>
<html>
<head>
  <title>Products</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<h1>Product List</h1>

<a href="/add-product">Add Product</a>

<ul>
  <% if (prods.length === 0) { %>
    <li>No Products Found</li>
  <% } %>

  <% prods.forEach(p => { %>
   <li>
  <a href="/products/<%= p.id %>">
    <%= p.title %>
  </a>
  - ₹<%= p.price %>
</li>
  <% }) %>
</ul>

</body>
</html>